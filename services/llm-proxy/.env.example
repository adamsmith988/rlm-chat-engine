# ============================================================================
# LLM Proxy Service Configuration
# کانفیگ سرویس پروکسی LLM
# ============================================================================

# Service Settings
PORT=8005

# Default Backend name (registry_sync overrides in production)
DEFAULT_BACKEND=openai_compat

# ============================================================================
# Registry-backed LLM backends (preferred)
# External OpenAI-compatible hosts: register via Admin → Storage DB.
# Do not hardcode upstream host/port here.
# ============================================================================
STORAGE_URL=http://localhost:8004
STRICT_LLM_BINDINGS=true
INTERNAL_API_KEY=

# ============================================================================
# OpenAI Configuration
# ============================================================================
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# DeepSeek Configuration
# ============================================================================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# Common Settings
# ============================================================================
DEFAULT_TIMEOUT=120.0
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
IMAGE_GEN_TIMEOUT=600
