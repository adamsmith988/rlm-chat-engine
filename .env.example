# Generated conceptually from config/settings.yaml. Copy to .env and edit.
# Do not put secrets in Python source.

RLM_CHAT_ENGINE_ROOT=.
RLM_SETTINGS_FILE=config/settings.yaml
DEFAULT_CHAT_ORCHESTRATOR=rlm
DOCK_CHAT_ORCHESTRATOR=rlm
STRICT_LLM_BINDINGS=true
LLM_ENABLE_THINKING=false
LLM_TOOL_CALL_PARSER=hermes
TOOL_PERMISSION_ENFORCEMENT=false
TOOL_RUNNER_RBAC_ENABLED=false
ALLOW_INSECURE_DEFAULTS=true
MEMORY_ENABLED=true
SKILLS_ENABLED=true
SKILLS_MARKDOWN_DIR=skills
AIV2_RLM_SKILLS_DIR=skills
LLM_PROXY_URL=http://127.0.0.1:8005
TOOL_RUNNER_URL=http://127.0.0.1:8002
STORAGE_URL=http://127.0.0.1:8004
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://rlm:rlm_pass@127.0.0.1:5432/rlm
INTERNAL_API_KEY=change-me-before-gpu-bringup
UI_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:8001
UI_PUBLIC_STORAGE_URL=http://127.0.0.1:8004
CHAT_MODEL_LOGICAL_ID=chat
EMBED_MODEL_LOGICAL_ID=embed
PYTHONPATH=packages/runtime-config/src:packages/aiv2-model-contract/src
